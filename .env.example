FLASK_APP=app.py
FLASK_DEBUG=0
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Private Starling credential used only by this server.
STARLING_ACCESS_TOKEN=

# Separate random secret for callers of this Flask API.
APP_API_KEY=

# Optional account/category overrides for the live diagnostic runner only.
STARLING_ACCOUNT_UID=
STARLING_CATEGORY_UID=

# Local PostgreSQL connection.
PGHOST=localhost
PGPORT=5432
PGDATABASE=TOMS
PGUSER=postgres
PGPASSWORD=

# Independent random session-signing key, at least 32 random bytes.
# Generate with: .venv/bin/python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
# Keep 1 behind Tailscale Serve HTTPS. Use 0 only for localhost HTTP development.
SESSION_COOKIE_SECURE=1
